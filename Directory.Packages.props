<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The .NET servicing train. ASP.NET Core and the in-box Microsoft.Extensions.* packages ship in lockstep with
         their runtime, so each TFM leg takes the train of its own runtime. Microsoft.AspNetCore.Mvc.Testing and
         Microsoft.AspNetCore.OpenApi floor the in-box packages at their own TFM's train and the Aspire client
         integrations floor them at a 10.0.x patch, so a lower direct reference is an NU1605 downgrade error. The train
         is hand-managed (see .github/dependabot.yml). -->
    <Net10FrameworkVersion>10.0.15</Net10FrameworkVersion>
    <FrameworkVersion>$(Net10FrameworkVersion)</FrameworkVersion>
    <FrameworkVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0</FrameworkVersion>
    <!-- EF Core is on the 10.x line on every TFM; EF Core 10 runs on .NET 11. The Npgsql provider has no EF Core 11
         release (its 11.0.0 release candidate requires exactly the matching EF Core release candidate), and a provider
         package, a test project, and EFCore.NamingConventions each need one EF Core major per TFM. -->
    <EfCoreVersion>$(Net10FrameworkVersion)</EfCoreVersion>
    <!-- Consumer opt-up EF floor for the non-provider src packages, applied via VersionOverride on their EF Core
         PackageReference items: they compile against the EF line of the oldest TFM and their published dependency
         groups floor there, so consumers on a newer TFM can keep that EF line or opt up to a newer EF themselves. The
         floor must equal the compile version AND the compiled assembly must run on every EF version the floor admits.
         Not every non-provider package qualifies: Vulthil.SharedKernel.Infrastructure.Relational tracks
         $(EfCoreVersion) because its compiled ExecuteUpdate setter calls are EF-major-coupled. Provider packages also
         track $(EfCoreVersion) because their EF Core providers are EF-major-locked. -->
    <EfCoreMinimumVersion>$(Net10FrameworkVersion)</EfCoreMinimumVersion>
    <!-- .github/actions/setup-build reads AspireVersion to prepare the matching Aspire CLI bundle. -->
    <AspireVersion>17.0.0</AspireVersion>
    <!-- The Aspire EF Core client integrations follow EF Core, not Aspire: from Aspire 17.0.0 the Cosmos integration
         takes EF Core 11 on net11.0 and the Npgsql one is only a preview, and EF Core is on the 10.x line on every
         TFM. -->
    <AspireEfCoreVersion>13.6.5</AspireEfCoreVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.CosmosDB" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.MySql" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Microsoft.EntityFrameworkCore.Cosmos" Version="$(AspireEfCoreVersion)" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(AspireEfCoreVersion)" />
    <PackageVersion Include="Aspire.RabbitMQ.Client" Version="$(AspireVersion)" />
    <!-- Test-only. Each EFCore.NamingConventions major requires the matching EF Core major, so it moves with $(EfCoreVersion). -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Meziantou.Extensions.Logging.Xunit.v3" Version="3.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(FrameworkVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(FrameworkVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="$(FrameworkVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EfCoreVersion)" />
    <!-- Each Microting.EntityFrameworkCore.MySql major requires the matching EF Core major, so it moves with $(EfCoreVersion). -->
    <PackageVersion Include="Microting.EntityFrameworkCore.MySql" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Cosmos" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <!-- The in-box Microsoft.Extensions.* packages are part of the .NET servicing train. Http.Resilience,
         ServiceDiscovery, and TimeProvider.Testing version on their own out-of-band cadence. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(FrameworkVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(FrameworkVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="$(FrameworkVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(FrameworkVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(FrameworkVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(FrameworkVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(FrameworkVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="$(FrameworkVersion)" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
    <!-- Samples only: restores the Storefront's front-end libraries from libman.json during the build. -->
    <PackageVersion Include="Microsoft.Web.LibraryManager.Build" Version="3.0.114" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <!-- Scoped to the Aspire DCP integration-test project only (via eng/coverage.ps1's
         split test invocation); retrying failed unit-suite tests would mask real flake. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.Retry" Version="2.5.3" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
    <PackageVersion Include="Moq.AutoMock" Version="4.0.3" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageVersion Include="ReportGenerator" Version="5.6.1" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Scalar.Aspire" Version="1.2.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.37.0.15768" />
    <PackageVersion Include="Testcontainers" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.CosmosDb" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.XunitV3" Version="4.17.0" />
    <PackageVersion Include="xunit.analyzers" Version="2.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />
  </ItemGroup>
</Project>