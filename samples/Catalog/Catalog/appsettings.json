{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "catalog-db": "",
    "rabbitMq": ""
  },
  "Messaging": {
    "Options": {
      "DefaultTimeout": "00:00:10"
    },
    "Queues": {
