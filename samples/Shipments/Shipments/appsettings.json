{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "shipments-db": "",
    "rabbitMq": ""
  },
  "Carrier": {
    "Name": "acme-express",
    "EstimateTimeout": "00:00:05",
    "SimulatorEnabled": true,
    "SimulatorInterval": "00:00:05"
  },
  "Shipments": {
    "Retention": {
      "Enabled": true,
      "RetentionPeriod": "30.00:00:00",
      "SweepInterval": "06:00:00",
      "BatchSize": 500
    }
  },
  "Messaging": {
    "Options": {
      "DefaultTimeout": "00:00:10",
      "FaultExchangeName": "samples.faults",
      "ConsumeFilters": {
        "EnableLogging": true
      }
    },
    "RabbitMq": {
      "PublishChannelPoolSize": 16
    },
    "Queues": {
      "shipment-commands": {
        "PrefetchCount": 32,
        "ChannelCount": 1,
        "ConcurrencyLimit": 4
      },
      "tracking-updates": {
        "PrefetchCount": 64
      },
      "carrier-requests": {
        "ConcurrencyLimit": 8
      }
    },
    "Messages": {
      "Shipments.Messages.ShipmentDelivered": {
        "Exchange": "samples.shipment-delivered",
        "ExchangeType": "Topic",
        "Durable": true
      }
    }
  }
}
