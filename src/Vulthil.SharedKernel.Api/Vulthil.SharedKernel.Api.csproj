<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>API-layer helpers for endpoints, controllers, and cross-cutting HTTP concerns.</Description>
		<PackageTags>aspnetcore;minimal-api;endpoints;controllers;problemdetails;openapi;result;http</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<!-- ProblemDetailsOperationTransformer uses Microsoft.OpenApi types through this package's own per-TFM
		     dependency (2.x on net10.0, 1.6.x on net9.0), so Microsoft.OpenApi is not referenced directly. -->
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Vulthil.Results\Vulthil.Results.csproj" />
	</ItemGroup>

</Project>
